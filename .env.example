# Copy this file to .env and fill in the values.
# Get a Discogs token at: https://www.discogs.com/settings/developers

DISCOGS_TOKEN=token here

# How long to cache Discogs responses, in seconds. Default 86400 = 24 hours.
DISCOGS_CACHE_TTL=86400

# User-Agent string sent to Discogs. Identify your app.
DISCOGS_USER_AGENT=VinylCollector/0.1

# Shared password to access the app.
APP_PASSWORD=change-this

# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Set to true ONLY when serving over HTTPS (i.e. on the deployed server).
# Leave false for local dev over http://localhost.
COOKIE_SECURE=false
