# Copy this file to .env and fill in your token.
# Get one at: https://www.discogs.com/settings/developers

DISCOGS_TOKEN=token here

# How long to cache Discogs responses, in seconds. Default 86400 = 24 hours.
DISCOGS_CACHE_TTL=86400

# User-Agent string sent to Discogs. Identify your app.
DISCOGS_USER_AGENT=VinylCollector/0.1
